# Copy to .env (gitignored); `docker compose` reads it automatically.

# Bearer token that clients must send to POST /register. Generate one with:
#   openssl rand -hex 16
# Empty means /register is open to anyone who can reach the relay.
RELAY_INVITE_SECRET=

# true only when a reverse proxy (Nginx Proxy Manager, Caddy, Cloudflare) in front of the
# relay sets X-Forwarded-For; the relay then uses its rightmost entry as the client IP for
# rate limits. Leave false when the relay is reachable directly.
RELAY_TRUST_PROXY=false

# Host address the relay's port 8090 is published on (docker compose). Default 127.0.0.1:
# only a proxy on this host can reach it. Set the host's LAN or docker bridge address (or
# 0.0.0.0, behind a firewall) when the proxy runs in a container and forwards to
# http://<host address>:8090. Never expose 8090 to the internet without the TLS proxy.
RELAY_BIND=127.0.0.1

# Optional (defaults shown). Only needed outside docker compose.
# RELAY_ADDR=:8090
# RELAY_STATE_FILE=/data/devices.json
